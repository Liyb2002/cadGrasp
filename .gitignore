# Ignore everything by default. Only Python sources and Markdown docs are tracked.
*
!*/
!*.py
!*.md

# Keep this policy itself under version control.
!/.gitignore

# Dependencies, caches and local tooling are never project source.
**/.git/
**/.venv/
**/venv/
**/env/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.ipynb_checkpoints/
/.agents/
/.codex/
/.aws/

# Local numerical runs and their execution snapshots.
/slides/Co-optimize/baseline_no_pso/runs/
