<mujoco model="tongs_object">
  <!-- TONGS demo object: a round puck with a thin PINCH TAB on top.
       The puck alone is un-graspable by a parallel jaw (round, too wide to pinch).
       The tab is the cadGrasp affordance: two parallel faces (the +/-x faces,
       8 mm apart) that a fixed two-jaw "tong" gripper can pinch and lift. -->
  <option gravity="0 0 -9.81"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="256" height="1536"/>
  </asset>
  <worldbody>
    <light pos="0 0 0.4" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0.3 0.3 0.05" rgba="0.30 0.30 0.35 1"/>
    <body name="object" pos="0 0 0">
      <geom name="base" type="cylinder" size="0.022 0.010" pos="0 0 0.010" rgba="0.45 0.50 0.60 1"/>
      <geom name="tab"  type="box"      size="0.004 0.014 0.018" pos="0 0 0.038" rgba="0.90 0.35 0.30 1"/>
    </body>
  </worldbody>
</mujoco>
