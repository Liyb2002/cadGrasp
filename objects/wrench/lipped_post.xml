<mujoco model="wrench_object">
  <!-- WRENCH demo object: a stem with an overhanging CAP (a mushroom / T).
       A parallel jaw slips off the smooth round cap. The cadGrasp affordance is
       the UNDERCUT LIP: the cap overhangs the stem, so beneath the cap rim
       (radius 8->20 mm, below z=0.036) there is open space for a fixed HOOK to
       slide in and catch under the lip, lifting the object by a moment. -->
  <option gravity="0 0 -9.81"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="256" height="1536"/>
  </asset>
  <worldbody>
    <light pos="0 0 0.4" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0.3 0.3 0.05" rgba="0.30 0.30 0.35 1"/>
    <body name="object" pos="0 0 0">
      <geom name="stem" type="cylinder" size="0.008 0.018" pos="0 0 0.018" rgba="0.45 0.50 0.60 1"/>
      <geom name="cap"  type="cylinder" size="0.020 0.006" pos="0 0 0.042" rgba="0.90 0.55 0.30 1"/>
    </body>
  </worldbody>
</mujoco>
