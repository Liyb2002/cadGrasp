<mujoco model="spanning_object">
  <!-- SPANNING demo object: a spool / hourglass with a narrow NECK between two
       wide disks. Too wide to pinch and heavy at the rims, so a jaw fails. The
       cadGrasp affordance is the WAIST: a fixed C-cage lowers around the 8 mm
       neck and lifts; the two 20 mm disks block axial escape (a geometric grasp,
       not a friction grasp). -->
  <option gravity="0 0 -9.81"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="256" height="1536"/>
  </asset>
  <worldbody>
    <light pos="0 0 0.4" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0.3 0.3 0.05" rgba="0.30 0.30 0.35 1"/>
    <body name="object" pos="0 0 0">
      <geom name="bottom" type="cylinder" size="0.020 0.008" pos="0 0 0.008" rgba="0.45 0.50 0.60 1"/>
      <geom name="neck"   type="cylinder" size="0.008 0.012" pos="0 0 0.028" rgba="0.90 0.60 0.30 1"/>
      <geom name="top"    type="cylinder" size="0.020 0.008" pos="0 0 0.048" rgba="0.45 0.50 0.60 1"/>
    </body>
  </worldbody>
</mujoco>
