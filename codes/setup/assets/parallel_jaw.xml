<!-- Generic simulation tool, NOT a model of any purchased gripper.
     160 mm opening; two identical straight 40 x 12 x 80 mm fingers.
     Dimensions fixed independently of the object's surface. -->
<mujoco model="generic parallel jaw">
  <compiler angle="radian" autolimits="true"/>
  <option/>
  <default><joint damping="1" armature=".01"/></default>
  <asset/>
  <worldbody>
    <body name="hand">
      <geom type="box" size=".025 .095 .02" pos="0 0 .02" mass=".65" rgba=".25 .28 .30 1"/>
      <body name="left_finger" pos="0 0 .04">
        <joint name="finger_joint1" type="slide" axis="0 1 0" range="0 .08"/>
        <geom type="box" size=".02 .006 .04" pos="0 .006 .04" mass=".10" rgba=".35 .39 .42 1"
              priority="1" solref=".002 1" solimp=".99 .999 .001"/>
      </body>
      <body name="right_finger" pos="0 0 .04" quat="0 0 0 1">
        <joint name="finger_joint2" type="slide" axis="0 1 0" range="0 .08"/>
        <geom type="box" size=".02 .006 .04" pos="0 .006 .04" mass=".10" rgba=".35 .39 .42 1"
              priority="1" solref=".002 1" solimp=".99 .999 .001"/>
      </body>
    </body>
  </worldbody>
  <contact><exclude body1="hand" body2="left_finger"/><exclude body1="hand" body2="right_finger"/></contact>
  <tendon><fixed name="split"><joint joint="finger_joint1" coef=".5"/><joint joint="finger_joint2" coef=".5"/></fixed></tendon>
  <equality><joint joint1="finger_joint1" joint2="finger_joint2" solref=".005 1"/></equality>
  <actuator><general name="close" tendon="split" biastype="affine"/></actuator>
</mujoco>
