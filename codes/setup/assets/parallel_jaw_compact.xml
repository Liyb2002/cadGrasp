<!-- Generic compact simulation tool; not a purchased-gripper certification.
     100 mm opening, straight 20 x 8 x 60 mm fingers. Fixed dimensions,
     no object-specific contour. Flange-to-fingertip reach remains 120 mm. -->
<mujoco model="generic compact parallel jaw">
  <compiler angle="radian" autolimits="true" />
  <option />
  <default>
    <joint damping="1" armature=".01" />
  </default>
  <asset />
  <worldbody>
    <body name="hand">
      <geom type="box" size=".020 .060 .030" pos="0 0 .030" mass=".45" rgba=".25 .28 .30 1" />
      <body name="left_finger" pos="0 0 .060">
        <joint name="finger_joint1" type="slide" axis="0 1 0" range="0 .05" />
        <geom type="box" size=".010 .004 .030" pos="0 .004 .030" mass=".055" rgba=".35 .39 .42 1" priority="1" solref=".002 1" solimp=".99 .999 .001" />
      </body>
      <body name="right_finger" pos="0 0 .060" quat="0 0 0 1">
        <joint name="finger_joint2" type="slide" axis="0 1 0" range="0 .05" />
        <geom type="box" size=".010 .004 .030" pos="0 .004 .030" mass=".055" rgba=".35 .39 .42 1" priority="1" solref=".002 1" solimp=".99 .999 .001" />
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="hand" body2="left_finger" />
    <exclude body1="hand" body2="right_finger" />
  </contact>
  <tendon>
    <fixed name="split">
      <joint joint="finger_joint1" coef=".5" />
      <joint joint="finger_joint2" coef=".5" />
    </fixed>
  </tendon>
  <equality>
    <joint joint1="finger_joint1" joint2="finger_joint2" solref=".005 1" />
  </equality>
  <actuator>
    <general name="close" tendon="split" biastype="affine" />
  </actuator>
</mujoco>
